#!/usr/bin/env bash
# The hippo launcher: a thin wrapper around `docker compose` so you never have
# to remember flags.
#
#   ./hippo up [--build]   start hippo (detects an Ollama on this machine; adds Neo4j if .env asks)
#   ./hippo down           stop everything (data is kept in ./data and the docker volumes)
#   ./hippo logs           follow the app's logs
#   ./hippo pull-models    download the LLM and embedding model into Ollama
#   ./hippo test           run the unit tests inside the app container
#   ./hippo ps             show what is running
#
# Anything else is passed straight to the `hippo` CLI inside the container,
# e.g. `./hippo ask "Who designed the Orion arm?"` or `./hippo sources`.

set -euo pipefail

cd "$(dirname "$0")"

OLLAMA_HOST_URL="http://localhost:11434"
DEFAULT_NEO4J_PASSWORD="hippo-password"   # what docker-compose.yml falls back to when .env has none
DB_FILE="./data/hippo.lbug"               # where the embedded graph lives (HIPPO_STORE=ladybug, the default)

# ------------------------------------------------------------ helpers

say() { printf '%s\n' "$*"; }

die() {
  say "error: $*" >&2
  exit 1
}

need_docker() {
  command -v docker >/dev/null 2>&1 \
    || die "docker is not installed. Get Docker Desktop from https://docs.docker.com/get-docker/ and try again."
  docker info >/dev/null 2>&1 \
    || die "docker is installed but not running (or you lack permission to use it). Start Docker Desktop, or add yourself to the 'docker' group."
  docker compose version >/dev/null 2>&1 \
    || die "'docker compose' (v2) is missing. Update Docker, or install the compose plugin: https://docs.docker.com/compose/install/"
}

host_has_ollama() {
  # curl exits non-zero when nothing answers; that is the "no Ollama here" case.
  command -v curl >/dev/null 2>&1 && curl -s --max-time 2 "$OLLAMA_HOST_URL/api/tags" >/dev/null 2>&1
}

# Which store the app uses: HIPPO_STORE in the environment wins (`just neo4j` sets it), then the
# HIPPO_STORE line of .env. "neo4j" runs a Neo4j container; anything else (or nothing) means the
# embedded LadybugDB file, which needs no extra service. docker compose reads the variable the same way.
store_backend() {
  local value="${HIPPO_STORE:-}"
  if [ -z "$value" ] && [ -f .env ]; then
    value="$(sed -n 's/^HIPPO_STORE=//p' .env | tail -n 1)"
  fi
  printf '%s\n' "${value:-ladybug}" | tr '[:upper:]' '[:lower:]'
}

uses_neo4j() {
  [ "$(store_backend)" = "neo4j" ]
}

# The NEO4J_PASSWORD line of .env, or the compose default when there is none.
neo4j_password() {
  local value=""
  if [ -f .env ]; then
    value="$(sed -n 's/^NEO4J_PASSWORD=//p' .env | tail -n 1)"
  fi
  printf '%s\n' "${value:-$DEFAULT_NEO4J_PASSWORD}"
}

random_password() {
  if command -v openssl >/dev/null 2>&1; then
    openssl rand -hex 16
  else
    # `head -c` reads exactly 32 bytes and exits 0, so this is safe under `pipefail`.
    head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n'
  fi
}

# The compose project name decides the volume name (<project>_neo4j_data).
neo4j_volume_exists() {
  local project
  project="${COMPOSE_PROJECT_NAME:-$(basename "$PWD" | tr '[:upper:]' '[:lower:]')}"
  docker volume inspect "${project}_neo4j_data" >/dev/null 2>&1
}

# Make sure .env has a NEO4J_PASSWORD. On the first run we write a random one;
# after that the same line is used every time, because Neo4j only reads the
# password when its data volume is created and would refuse a new one later.
ensure_neo4j_password() {
  if [ -f .env ] && grep -q '^NEO4J_PASSWORD=.' .env; then
    return
  fi
  if [ -f .env ]; then
    # Drop an empty "NEO4J_PASSWORD=" line (as in .env.example) so the file ends up with one line.
    { grep -v '^NEO4J_PASSWORD=$' .env || true; } > .env.tmp && mv .env.tmp .env
  fi
  local password
  if neo4j_volume_exists; then
    # A database already exists, made with the old fixed password: keep using it.
    password="$DEFAULT_NEO4J_PASSWORD"
    say "Your Neo4j database was created with the default password; writing NEO4J_PASSWORD=$password to .env."
    say "To change it later: ./hippo down, docker volume rm the neo4j_data volume (this erases the memory), edit .env, ./hippo up."
  else
    password="$(random_password)"
    say "First run: wrote a random NEO4J_PASSWORD to .env. Keep that file; Neo4j only accepts it because it was set on first start."
  fi
  {
    printf '\n# Neo4j password, written by ./hippo up. Keep it: the database only accepts this one.\n'
    printf 'NEO4J_PASSWORD=%s\n' "$password"
  } >> .env
}

print_urls() {
  say ""
  say "hippo is up (ports are open to this machine only):"
  say "  UI             http://localhost:8000"
  say "  MCP            http://localhost:8000/mcp"
  if uses_neo4j; then
    local password
    password="$(neo4j_password)"
    say "  Neo4j browser  http://localhost:7474   (user: neo4j / password: $password, from .env)"
    if [ "$password" = "$DEFAULT_NEO4J_PASSWORD" ]; then
      say "  warning: Neo4j is using the default password; set NEO4J_PASSWORD in .env for a fresh database."
    fi
  else
    say "  Graph          $DB_FILE   (an embedded LadybugDB file; copy it to back up your memory)"
  fi
  say ""
  say "First time? Open the UI, click 'Load the sample', then ask: Who designed the Orion arm?"
  say "Models are downloaded on first start; watch the header of the UI, or run: ./hippo pull-models"
}

# `docker compose` with the ollama and/or neo4j profiles switched on when those containers are wanted.
compose() {
  local profiles=()
  if [ "${USE_OLLAMA_PROFILE:-0}" = "1" ]; then
    profiles+=(--profile ollama)
  fi
  if [ "${USE_NEO4J_PROFILE:-0}" = "1" ]; then
    profiles+=(--profile neo4j)
  fi
  # The ${arr[@]+...} form keeps `set -u` happy on bash 3.2 (macOS) when no profile is wanted.
  docker compose ${profiles[@]+"${profiles[@]}"} "$@"
}

# ----------------------------------------------------------- commands

cmd_up() {
  need_docker
  local build_flag=""
  if [ "${1:-}" = "--build" ]; then
    build_flag="--build"
  fi
  mkdir -p data
  if uses_neo4j; then
    say "Graph store: Neo4j (HIPPO_STORE=neo4j). Starting a Neo4j container for the graph."
    ensure_neo4j_password
    export HIPPO_STORE=neo4j   # so compose gives the app the same answer, whatever .env says
    export USE_NEO4J_PROFILE=1
  else
    say "Graph store: embedded LadybugDB file at $DB_FILE (HIPPO_STORE=ladybug). No database container."
    export HIPPO_STORE=ladybug
    export USE_NEO4J_PROFILE=0
  fi

  if host_has_ollama; then
    say "Found Ollama on this machine at $OLLAMA_HOST_URL; the app will use it."
    export OLLAMA_URL="http://host.docker.internal:11434"
    export USE_OLLAMA_PROFILE=0
  else
    say "No Ollama found on this machine; starting the ollama container as well."
    export OLLAMA_URL="http://ollama:11434"
    export USE_OLLAMA_PROFILE=1
  fi

  # shellcheck disable=SC2086  (build_flag is either empty or "--build")
  compose up -d $build_flag
  print_urls
}

cmd_down() {
  need_docker
  # Include the profiles so the ollama and neo4j containers are stopped too, if they were started.
  docker compose --profile ollama --profile neo4j down
  say "Stopped. Your data is still in ./data (and the docker volumes); './hippo up' brings it back."
}

cmd_logs() {
  need_docker
  docker compose logs -f app
}

cmd_pull_models() {
  need_docker
  docker compose exec app hippo pull-models
}

cmd_test() {
  need_docker
  # The image holds only the app (no tests, no pytest), so mount this folder into a throwaway
  # container. The tests use throwaway database files (HIPPO_TEST_STORE=ladybug) and never touch
  # your real memory; NEO4J_URI is blanked so the store fixture cannot point at a real Neo4j either.
  docker compose run --rm --no-deps -e NEO4J_URI= -e HIPPO_TEST_STORE=ladybug -v "$PWD:/src" app \
    sh -c 'pip install -q pytest && cd /src && python -m pytest tests/unit -q -p no:cacheprovider'
}

cmd_ps() {
  need_docker
  docker compose --profile ollama --profile neo4j ps
}

# The HIPPO_TOKEN line of .env (or the variable in your shell): the CLI needs it once users exist.
hippo_token() {
  if [ -n "${HIPPO_TOKEN:-}" ]; then
    printf '%s\n' "$HIPPO_TOKEN"
  elif [ -f .env ]; then
    sed -n 's/^HIPPO_TOKEN=//p' .env | tail -n 1
  fi
}

# The CLI runs inside the app container. The server there holds the embedded database, so the
# commands talk to it over the API (see src/hippo/remote.py); once users exist that needs your token.
cmd_cli() {
  need_docker
  local token
  token="$(hippo_token)"
  if [ -n "$token" ]; then
    docker compose exec -e "HIPPO_TOKEN=$token" app hippo "$@"
  else
    docker compose exec app hippo "$@"
  fi
}

usage() {
  sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'
}

# --------------------------------------------------------------- main

case "${1:-}" in
  up) shift; cmd_up "$@" ;;
  down) cmd_down ;;
  logs) cmd_logs ;;
  pull-models) cmd_pull_models ;;
  test) cmd_test ;;
  ps) cmd_ps ;;
  -h|--help|help|"") usage ;;
  *) cmd_cli "$@" ;;
esac
