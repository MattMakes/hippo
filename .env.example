# Copy this file to .env and change what you need. Every value has a sensible
# default (see src/hippo/config.py), so an empty .env is fine.
# docker compose reads .env automatically; `hippo` on your laptop reads the
# environment, so `export` these or use a tool like direnv.

# ---- The graph: where hippo's memory lives -----------------------------------
# "ladybug" (the default) keeps everything in one embedded LadybugDB file; nothing to run.
# "neo4j" uses a Neo4j server instead (`pip install 'hippo[neo4j]'`; with docker, `./hippo up`
# starts one for you when this says neo4j). `just ladybug` / `just neo4j` override this for one start.
HIPPO_STORE=ladybug
# The LadybugDB file. Empty means <HIPPO_DATA_DIR>/hippo.lbug. Back it up by copying it while
# hippo is stopped. One process may open it at a time; the CLI talks to a running server instead.
HIPPO_DB_PATH=

# Your API/MCP token (Account page), for the CLI once users exist: `hippo ask` and friends talk to the
# running server, which needs to know who you are. `./hippo <command>` passes it into the container.
HIPPO_TOKEN=

# ---- Neo4j (only read when HIPPO_STORE=neo4j) ---------------------------------
# Inside docker compose the app uses bolt://neo4j:7687; on a laptop, localhost.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# Leave this empty: `./hippo up` writes a random password here on the first run, and both
# containers read it from this file. Neo4j only accepts the password it was created with,
# so do not change it once the neo4j_data volume exists. Without docker, set your own.
NEO4J_PASSWORD=

# ---- Ollama: where the models run -------------------------------------------
# ./hippo up sets this for you: your machine's Ollama (http://host.docker.internal:11434)
# or the ollama container (http://ollama:11434). On a laptop, localhost.
OLLAMA_URL=http://localhost:11434
# The chat model: extracts facts, filters facts, answers questions, judges answers.
HIPPO_LLM_MODEL=qwen3:8b
# The embedding model: turns text into vectors. Changing it means re-indexing everything.
HIPPO_EMBED_MODEL=nomic-embed-text
# Context window asked of Ollama (qwen3 defaults to 4k, which is too small for the QA prompt).
HIPPO_NUM_CTX=8192
# Seconds to wait for one LLM reply. Local 8B models on CPU can be slow.
HIPPO_LLM_TIMEOUT=600

# ---- Files -------------------------------------------------------------------
# Uploaded files, cloned repos and (by default) the graph database file are kept here
# (/app/data inside the container).
HIPPO_DATA_DIR=./data
# Biggest upload or pasted text, in bytes (50 MB).
HIPPO_MAX_UPLOAD_BYTES=50000000
# Most text one source may turn into, in characters (20 M, about 13,000 passages). A small
# epub or zip can unpack to far more than its size; past this the source fails as "too large".
HIPPO_MAX_TEXT_CHARS=20000000

# ---- Indexing ----------------------------------------------------------------
# Parallel LLM calls while extracting facts (Ollama serves ~1-4 at a time).
HIPPO_OPENIE_WORKERS=2
# Passage size in characters (~350 tokens) and the overlap between neighbouring passages.
HIPPO_CHUNK_SIZE=1500
HIPPO_CHUNK_OVERLAP=150

# ---- Users -------------------------------------------------------------------
# hippo starts open (no users: everyone sees everything). Create the first user on the Users page
# or with `./hippo user add <name>`; from then on every page, API and MCP call needs a sign-in.
# `hippo mcp` (stdio) identifies its user with this token (from the Account page). Not used by compose.
HIPPO_TOKEN=

# ---- Web server --------------------------------------------------------------
# `hippo serve` on a laptop listens on HIPPO_HOST, this machine only by default: hippo has no
# login. Inside docker compose the app listens on 0.0.0.0 and the port is published on
# HIPPO_BIND (127.0.0.1 by default). Set HIPPO_BIND=0.0.0.0 only behind a proxy that asks for a
# password, and add the names you will use to HIPPO_ALLOWED_HOSTS.
HIPPO_HOST=127.0.0.1
HIPPO_PORT=8000
HIPPO_BIND=127.0.0.1
# Host names the UI and /mcp answer to, on top of localhost, 127.0.0.1 and [::1] (comma-separated).
# Unknown names are refused to keep other websites away from your memory (see Users in the README).
# Add your machine's LAN name or IP if you open hippo from another computer; "*" switches the check off.
HIPPO_ALLOWED_HOSTS=
